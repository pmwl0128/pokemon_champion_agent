{
  "name": "@pokemon-champions/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Web protocol layer: capabilities handshake + Web DTO Zod schemas shared by the online site and the local bridge UI (frontend/design.md §3).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./schema/protocol.schema.json"
  },
  "scripts": {
    "schema": "node scripts/export-json-schema.mjs",
    "schema:check": "node scripts/export-json-schema.mjs --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
