# Line-ending & binary policy for the public skills + companion-app source repo.
# The release is a clean snapshot with no dev/update tree, so a single global rule keeps it
# LF-clean — Windows and Unix users never see CRLF churn.

* text=auto eol=lf

# Binary types: never normalize (the dex ships a SQLite db; the env-change xlsx is a zip; cover assets).
*.xlsx    binary
*.sqlite  binary
*.db      binary
*.parquet binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.pdf     binary
*.gz      binary
*.tgz     binary
*.zip     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
