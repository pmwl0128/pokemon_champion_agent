# Runtime / regenerated artifacts — never part of the public source snapshot.
__pycache__/
*.pyc
node_modules/
apps/web/dist/
apps/web/public/projection/
packages/*/dist/

# Generated binaries ship on the rolling data-latest release, not in Git history.
*.xlsx
*.zip

# The real-team library (data/teams/*.jsonl + index.json) IS shipped data and is tracked here.
# Only the dev-side quarantine audit is excluded (defensive; it should never appear in a release).
**/data/teams/quarantine/
